#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.."
source tools/ubuntu_env.sh
if ! command -v ncu >/dev/null 2>&1; then
  echo "ncu is missing; install the Linux Nsight Compute CLI to profile this optional experiment." >&2
  exit 2
fi
if [[ ! -x build/ubuntu/hw8_task3 ]]; then
  echo "Build first: bash exercises/hw8/task3/build_nvcc" >&2
  exit 2
fi
exec ncu --section MemoryWorkloadAnalysis --launch-count 1 ./build/ubuntu/hw8_task3 "$@"
